# Database (Postgres)
DATABASE_URL=postgres://user:password@localhost:5432/emocog

# Server
NODE_ENV=development
PORT=3000
# In production use HTTPS only (reverse proxy or TLS). Do not send PII in API requests.

# JWT (на сервере при NODE_ENV=production обязательно: своя случайная строка ≥32 символов, иначе API не стартует)
# Сгенерировать: openssl rand -base64 48
JWT_SECRET=your-secret-min-32-chars-long
JWT_EXPIRES_IN=1h
STAFF_SESSION_COOKIE=wecog_staff_session
# Participant token is bound to one session and invitation.
INGEST_TOKEN_EXPIRES_IN=15m
FORCE_HTTPS=true
# In production JWT_SECRET is mandatory (no fallback secret is allowed).

# Browser origins allowed to call the bearer API. No wildcard with credentials.
CORS_ORIGINS=https://wecog.ru
# Set only when direct access to Node is blocked and exactly one trusted proxy is in front.
TRUST_PROXY_HOPS=1
AUTH_BODY_LIMIT=32kb
INGEST_BODY_LIMIT=2mb
DEFAULT_BODY_LIMIT=256kb
AUTH_RATE_LIMIT_PER_MINUTE=20
INGEST_RATE_LIMIT_PER_MINUTE=120
DEFAULT_RATE_LIMIT_PER_MINUTE=300

# Server-owned root for uploaded binaries.
UPLOADS_ROOT=/var/lib/wecog/uploads
MAX_UPLOAD_BYTES=52428800
MAX_DOCUMENT_BYTES=52428800
MAX_DOCUMENT_PAGES=100
DOCUMENT_CONVERSION_TIMEOUT_MS=45000
DOCUMENT_CONVERSION_DPI=150
DOCUMENT_CONVERSION_CONCURRENCY=2
RT_PYTHON=python3
# LIBREOFFICE_BIN=soffice
# PDFINFO_BIN=pdfinfo
# PDFTOPPM_BIN=pdftoppm

# Used only by: npm run admin:bootstrap
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=<min-12-char-secret>

# Optional: base URL for participant upload (UPLOAD_AGGREGATES_URL)
# BASE_URL=https://api.example.com
