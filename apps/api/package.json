{
  "name": "emocog-api",
  "version": "1.0.0",
  "description": "Backend API — Фаза 2 (auth, orgs, projects, sessions, events, ingest, QC, export)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node-pg-migrate",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create",
    "migrate:verify": "bash scripts/verify-migrations.sh",
    "backup:db": "bash scripts/backup-db.sh",
    "backup:media": "node scripts/backup-media-set.js",
    "restore:db": "bash scripts/restore-db.sh",
    "backup:verify": "bash scripts/verify-backup-restore.sh",
    "backup:verify-media": "node scripts/verify-media-restore.js",
    "identity:local": "node scripts/identity-local.js",
    "media:reconcile": "node scripts/reconcile-media.js",
    "load:ingest": "node scripts/load-ingest.js",
    "load:stimuli": "node scripts/load-stimuli.js",
    "admin:bootstrap": "node scripts/bootstrap-admin.js",
    "test": "node --test tests/*.test.js tests/*.test.mjs",
    "test:postgres": "node --test --test-concurrency=1 tests/*.integration.test.js",
    "test:release": "node --test tests/server-lifecycle.test.js tests/bulk-insert.test.js tests/release-hardening.test.js",
    "test:rt-python": "python3 -B ../../rt_component-/scripts/analyze_events_json.py < ../../rt_component-/tests/smoke_input.json && python3 -B -m unittest discover -s ../../rt_component-/tests -v",
    "test:reference:video": "node ../../scripts/reference-data/replay.mjs",
    "test:reference:signals": "node ../../scripts/reference-data/bidmc.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "node-pg-migrate": "^6.2.2",
    "nodemailer": "10.3.1",
    "pg": "^8.11.3"
  },
  "overrides": {
    "qs": "6.16.1",
    "proxy-addr": "2.0.8"
  },
  "private": true
}
