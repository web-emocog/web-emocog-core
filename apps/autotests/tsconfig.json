{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "node",
    "types": ["node", "@playwright/test"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["tests/**/*", "playwright.config.ts", "playwright.analytics.config.ts", "playwright.workers.config.ts", "playwright.fps.config.ts", "playwright.staff-http.config.ts", "playwright.staff-regression.config.ts", "playwright.html-security.config.ts"],
  "exclude": ["node_modules"]
}
