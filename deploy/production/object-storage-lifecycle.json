{
  "lifecycleRules": [
    {
      "id": "expire-automated-postgresql-backups",
      "enabled": true,
      "filter": {
        "prefix": "postgresql/"
      },
      "expiration": {
        "days": "35"
      },
      "noncurrent_expiration": {
        "noncurrent_days": "2"
      },
      "abort_incomplete_multipart_upload": {
        "days_after_expiration": "1"
      },
      "noncurrent_delete_markers": {
        "noncurrent_days": "2"
      }
    }
  ]
}
